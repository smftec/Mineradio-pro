{
  "name": "mineradio-pro",
  "productName": "Mineradio pro",
  "version": "2.3.0",
  "description": "Mineradio pro — 本地音乐播放器,支持多格式播放、歌词、桌面歌词、迷你播放器与软件自动更新",
  "main": "desktop/bootstrap.cjs",
  "type": "module",
  "author": "Mineradio pro",
  "license": "MIT",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build:win": "electron-builder --win --publish never",
    "build:win:dir": "electron-builder --win dir --publish never",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "chardet": "^2.0.0",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.6.0",
    "iconv-lite": "^0.6.3",
    "music-metadata": "^11.0.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.0"
  },
  "build": {
    "appId": "com.mineradio.pro",
    "productName": "Mineradio pro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mineradio pro",
      "artifactName": "Mineradio-pro-${version}-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "smftec",
      "repo": "Mineradio-pro"
    }
  }
}
